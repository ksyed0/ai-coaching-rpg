# Model provider for NPCs and the Game Master: mock (default, no key) | anthropic | openrouter | local
MODEL_PROVIDER=mock

# --- anthropic ---------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional custom endpoint or proxy (https, or http on localhost only). Do not include /v1.
# ANTHROPIC_BASE_URL=https://my-proxy.example.com/anthropic

# --- openrouter (MODEL_PROVIDER=openrouter) ------------------------------------------------------
# OPENROUTER_API_KEY=sk-or-...
# Optional; default https://openrouter.ai/api/v1 (must be https, except on localhost)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- local OpenAI-compatible server (MODEL_PROVIDER=local) ---------------------------------------
# Ollama: http://localhost:11434/v1    LM Studio: http://localhost:1234/v1    (vLLM, llama.cpp server also work)
# Inside Docker, "localhost" is the container: use http://host.docker.internal:11434/v1 instead.
# LOCAL_BASE_URL=http://localhost:11434/v1
# Optional: only if your server wants a token (a dummy value is fine for most). Sent as "Authorization: Bearer ..."
# LOCAL_API_KEY=
# For "local" NPC_MODEL and GM_MODEL are REQUIRED (model ids are server-specific), e.g. llama3.1 (Ollama).

# Model ids. Blank = the provider default: claude-sonnet-5-5 (anthropic), anthropic/claude-sonnet-5.5 (openrouter).
# Prompts (scenario text, player lines) are sent to whichever endpoint you configure.
NPC_MODEL=
GM_MODEL=

RUNTIME_PORT=8080
# NPC timeouts in milliseconds (whole numbers, 500 to 600000). Raise them for reasoning models, free-tier OpenRouter
# or slow local models. The reply deadline must be >= the first-token timeout.
# NPC_FIRST_TOKEN_TIMEOUT_MS=10000
# NPC_REPLY_TIMEOUT_MS=20000
# Token budgets (max_tokens) per model call, whole numbers 50 to 4000. A reasoning model spends part of the budget thinking before it
# answers, and none of that thinking is shown, so the whole thinking phase must fit inside NPC_FIRST_TOKEN_TIMEOUT_MS. If the facilitator
# sees "empty reply: reasoning budget exhausted", raise these AND raise NPC_FIRST_TOKEN_TIMEOUT_MS and NPC_REPLY_TIMEOUT_MS with them
# (roughly the budget divided by the model's tokens per second, plus margin). A bigger budget alone makes the wait longer.
# Sampling temperature per model call (a decimal, 0 to 2). NPC_TEMPERATURE: AI characters (default 0.8); PLAYER_TEMPERATURE: the demo's
# generated player bots, `pnpm demo --showcase --live --players generated` (default 0.9); GM_TEMPERATURE: Game Master verdicts (default 0.2).
# NPC_TEMPERATURE=0.8
# PLAYER_TEMPERATURE=0.9
# GM_TEMPERATURE=0.2
# NPC_MAX_TOKENS=600
# GM_MAX_TOKENS=400
# Game Master reliability (US-0025). GM_TIMEOUT_MS: the deadline of one Game Master call with its retries and re-ask, 500 to 600000 (unset keeps
# max(NPC_REPLY_TIMEOUT_MS, 60 s); worst case 2 asks x (1 + MODEL_MAX_RETRIES) requests inside it). GM_REASK: 1 (default) asks once more after a reply with no usable verdict, 0 turns the re-ask off.
# GM_EVERY_N_UTTERANCES: judge the exit conditions after this many new utterances in a scene, 1 to 20 (default 3).
# GM_TRACE_FILE: off by default; a file (relative to data/sessions; never a *.jsonl file there, a symbolic link or a hard-linked file) that records every raw Game Master reply and how it was read, mode 0600.
# It holds model replies about the whole conversation: keep it private. Replay it offline with `pnpm gm-eval --trace <file>`.
# GM_TIMEOUT_MS=
# GM_REASK=1
# GM_EVERY_N_UTTERANCES=3
# GM_TRACE_FILE=
# Transient model errors (overloaded, rate limit, 5xx, connection reset) are retried before the NPC speaks its fallback line.
# MODEL_MAX_RETRIES: 0 to 5 (default 2, so up to 3 attempts; 0 disables). MODEL_RETRY_BASE_MS: 100 to 10000 (default 500; doubles per retry).
# Retries stop at the deadlines: the NPC timeouts above, and for the Game Master max(NPC_REPLY_TIMEOUT_MS, 60 s).
# A base above 4000 raises the backoff cap with it. A refused connection is retried too (a model server that is off costs ~1.5 s).
# MODEL_MAX_RETRIES=2
# MODEL_RETRY_BASE_MS=500
# SESSION_ID=local
# SCENARIO_DIR=scenarios/friday-escalation
DEPLOYMENT_STAGE=local
# Live model contract tests call the real API (cost!). Opt-in only: needs this flag AND ANTHROPIC_API_KEY.
# RUN_LIVE_MODEL_TESTS=1

# Post-session evaluator (`pnpm evaluate`, `pnpm demo --showcase --evaluate`; see docs/EVALUATOR.md). EVAL_MODEL defaults to NPC_MODEL.
# EVAL_MODEL=
# EVAL_MAX_TOKENS=3000
# EVAL_TEMPERATURE=0.2
# EVAL_TIMEOUT_MS=180000
# EVAL_TRANSCRIPT_CHARS=60000
