  "stories": [
    {
      "id": "US-0001",
      "epicId": "EPIC-0001",
      "title": "As a developer, I want a pnpm monorepo with TypeScript and Vitest, so that every package builds and tests with one command.",
      "priority": "High",
      "estimate": "S",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0001",
          "text": "`pnpm install && pnpm test && pnpm typecheck` succeed from a clean clone",
          "done": false
        },
        {
          "id": "AC-0002",
          "text": "packages import each other as @acr/<name> workspace links",
          "done": false
        }
      ],
      "dependencies": []
    },
    {
      "id": "US-0002",
      "epicId": "EPIC-0001",
      "title": "As the runtime, I want typed session events and a pure reducer, so that session state is always a projection of the event log.",
      "priority": "High",
      "estimate": "M",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0003",
          "text": "reduce() rejects out-of-order seq",
          "done": false
        },
        {
          "id": "AC-0004",
          "text": "visibleTranscript() returns only scenes the role participated in",
          "done": false
        },
        {
          "id": "AC-0005",
          "text": "pause, resume, scene entry/exit, injects and NPC updates are reflected in state",
          "done": false
        }
      ],
      "dependencies": [
        "US-0001"
      ]
    },
    {
      "id": "US-0003",
      "epicId": "EPIC-0001",
      "title": "As a scenario author, I want my YAML scenario folder loaded and validated, so that mistakes are reported before a session starts.",
      "priority": "High",
      "estimate": "M",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0006",
          "text": "loadScenario reads scenario.yaml, roles/*.yaml and script.yaml",
          "done": false
        },
        {
          "id": "AC-0007",
          "text": "a missing roles/ directory fails with one message naming the folder",
          "done": false
        },
        {
          "id": "AC-0008",
          "text": "validator errors on unknown participants and duplicate inject ids",
          "done": false
        },
        {
          "id": "AC-0009",
          "text": "validator warns on injects past the time box and objectives with no criteria",
          "done": false
        },
        {
          "id": "AC-0010",
          "text": "a JSON Schema is exported for editors",
          "done": false
        }
      ],
      "dependencies": [
        "US-0002"
      ]
    },
    {
      "id": "US-0004",
      "epicId": "EPIC-0001",
      "title": "As the runtime, I want a scene state machine, so that scenes exit on time box, facilitator advance or a Game Master verdict.",
      "priority": "High",
      "estimate": "S",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0011",
          "text": "evaluateExit honours only the conditions a scene lists",
          "done": false
        },
        {
          "id": "AC-0012",
          "text": "dueInjects returns timed injects once",
          "done": false
        }
      ],
      "dependencies": [
        "US-0003"
      ]
    },
    {
      "id": "US-0005",
      "epicId": "EPIC-0001",
      "title": "As the runtime, I want a ModelProvider adapter with a mock and an Anthropic implementation, so that NPCs run in tests without a key and with a real model in play.",
      "priority": "High",
      "estimate": "M",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0013",
          "text": "the contract suite passes for the mock and (with a key) for Anthropic",
          "done": false
        },
        {
          "id": "AC-0014",
          "text": "MockModelProvider replays scripted replies and records calls",
          "done": false
        },
        {
          "id": "AC-0015",
          "text": "no file outside packages/adapters imports a provider SDK (lint)",
          "done": false
        }
      ],
      "dependencies": [
        "US-0004"
      ]
    },
    {
      "id": "US-0006",
      "epicId": "EPIC-0001",
      "title": "As a facilitator, I want a session engine that runs the script, so that scenes advance, injects fire and every turn is logged.",
      "priority": "High",
      "estimate": "L",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0016",
          "text": "start() enters the first scene and fires its opening inject",
          "done": false
        },
        {
          "id": "AC-0017",
          "text": "say() is refused while paused or when the role is not in the scene",
          "done": false
        },
        {
          "id": "AC-0018",
          "text": "timed injects fire once on tick",
          "done": false
        },
        {
          "id": "AC-0019",
          "text": "scenes exit on time box, advance or GM verdict and the session ends after the last scene",
          "done": false
        },
        {
          "id": "AC-0020",
          "text": "events persist to a JSONL log with monotonic seq",
          "done": false
        }
      ],
      "dependencies": [
        "US-0005"
      ]
    },
    {
      "id": "US-0007",
      "epicId": "EPIC-0001",
      "title": "As a participant, I want NPCs to reply in character, so that the role-play feels real.",
      "priority": "High",
      "estimate": "L",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0021",
          "text": "the persona prefix is cacheable and contains goals, knowledge, guardrails and the scene goal",
          "done": false
        },
        {
          "id": "AC-0022",
          "text": "hidden facts and other roles' briefs never appear in NPC prompts",
          "done": false
        },
        {
          "id": "AC-0023",
          "text": "on timeout or empty reply the fallback line is spoken and the facilitator is alerted",
          "done": false
        },
        {
          "id": "AC-0024",
          "text": "NPCs stay silent while paused or outside their scene",
          "done": false
        }
      ],
      "dependencies": [
        "US-0006"
      ]
    },
    {
      "id": "US-0008",
      "epicId": "EPIC-0001",
      "title": "As a facilitator, I want the Game Master to detect scripted exit conditions, so that scenes move on when the team achieves the goal.",
      "priority": "High",
      "estimate": "M",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0025",
          "text": "the GM evaluates gm_detects conditions every N utterances, not per turn",
          "done": false
        },
        {
          "id": "AC-0026",
          "text": "a true verdict exits the scene in the same tick and is logged with reasoning",
          "done": false
        },
        {
          "id": "AC-0027",
          "text": "unparseable or false verdicts leave the scene running",
          "done": false
        }
      ],
      "dependencies": [
        "US-0007"
      ]
    },
    {
      "id": "US-0009",
      "epicId": "EPIC-0001",
      "title": "As a participant, I want to join a session over WebSocket with my role, so that I can play from any machine on the LAN.",
      "priority": "High",
      "estimate": "L",
      "status": "Planned",
      "branch": "feature/EPIC-0001-US-0001-monorepo",
      "acs": [
        {
          "id": "AC-0028",
          "text": "a second participant claiming a taken role is refused with role_taken",
          "done": false
        },
        {
          "id": "AC-0029",
          "text": "players receive only events for scenes and injects addressed to them; the facilitator receives everything",
          "done": false
        },
        {
          "id": "AC-0030",
          "text": "the facilitator can start the session and send commands; players cannot",
          "done": false
        }
      ],
      "dependencies": [
        "US-0008"
      ]
