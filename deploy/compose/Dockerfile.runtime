# Runtime image for the AI Coaching RPG server (Slice 1).
# Base image is pinned to a specific Node 22 / Alpine tag; bump it deliberately.
FROM node:22.23.3-alpine

# Exact pnpm version from package.json "packageManager" (corepack is not relied on).
RUN npm install -g pnpm@9.15.9

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
COPY services ./services
COPY scenarios ./scenarios

# Only the runtime and the workspace packages it depends on. tsx (a devDependency of
# @acr/runtime) stays installed because the start script runs `tsx src/main.ts`.
RUN pnpm install --frozen-lockfile --filter "@acr/runtime..." \
    && mkdir -p /app/data/sessions \
    && chown -R node:node /app/data

USER node
WORKDIR /app/services/runtime
EXPOSE 8080

# No curl in the image: open a TCP connection to the listening port.
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD ["node", "-e", "const s=require('net').connect(8080,'127.0.0.1');s.on('connect',()=>process.exit(0));s.on('error',()=>process.exit(1))"]

CMD ["./node_modules/.bin/tsx", "src/main.ts"]
