{
  "name": "@acr/voice-ops",
  "version": "0.2.1",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "scripts": {
    "voice-up": "node --import tsx src/cli.ts up",
    "voice-down": "node --import tsx src/cli.ts down",
    "voice-check": "node --import tsx src/cli.ts check",
    "voice-timings": "node --import tsx src/cli.ts timings",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acr/adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
